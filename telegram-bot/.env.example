# Telegram bot credentials. Copy this file to .env (gitignored) and fill in:
#   cp .env.example .env
#
# TELEGRAM_BOT_TOKEN: from @BotFather after creating a bot (/newbot).
# TELEGRAM_CHAT_ID: your own chat id — the bot ONLY responds to this chat,
#   since it can approve real HR/payroll requests. Find yours by messaging
#   your bot once, then GET https://api.telegram.org/bot<token>/getUpdates
#   and read message.chat.id from the response.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
